# SereneDB — local Docker, trust auth, loopback only. No credentials by default.
SERENEDB_HOST=127.0.0.1
SERENEDB_PORT=7890
SERENEDB_USER=postgres
SERENEDB_PASSWORD=
SERENEDB_DB=postgres

# Paths as the CONTAINER sees them (mount: -v "$PWD/data":/data)
SERENEDB_DATA=/data/loghub
SERENEDB_MAP=/data/ownership.csv

# --- Stage 6: role-scoped connections (one per persona; password set at bootstrap) ---
# Never commit real passwords. These are dev-only and are rotated before submission.
EXHIBIT_ROLE=engineer
EXHIBIT_ENGINEER_USER=exhibit_engineer
EXHIBIT_LEAD_USER=exhibit_lead
EXHIBIT_MANAGER_USER=exhibit_manager

# --- agent ---
# Default client for the 5-minute demo. MCP server is spoken over stdio.
MCP_TRANSPORT=stdio

# --- optional: huge-datasets bench (remote Parquet; nothing is downloaded) ---
OTEL_PARQUET_URL=https://public-pme.s3.eu-west-3.amazonaws.com/text_bench/part_000.parquet
BENCH_MINUTES=3
